{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false
  },
  "include": ["shared/**/*.ts", "server/src/**/*.ts", "server/tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
